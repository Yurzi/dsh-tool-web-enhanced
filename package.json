{
  "name": "dsh-tool-web-enhanced-workspace",
  "private": true,
  "description": "Monorepo of dsh-tool-web-enhanced-profile: enhanced web_search and web_fetch for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "Yurzi",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --filter \"./packages/**\" run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:package": "node scripts/verify-packages.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test && pnpm run verify:package",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/cordis-plugin-include": "catalog:",
    "@deepseek-ai/dsh-web": "catalog:",
    "@types/node": "^22.20.0",
    "dsh-tool-web-enhanced-core": "workspace:*",
    "@vitest/coverage-v8": "^4.1.8",
    "lightningcss": "^1.30.2",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright-core": "^1.61.1",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  }
}
