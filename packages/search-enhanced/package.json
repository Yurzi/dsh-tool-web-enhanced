{
  "name": "dsh-web-search-enhanced",
  "version": "0.2.0",
  "description": "web_search provider for DeepSeek Harness with switchable search backends; installed through dsh-tool-web-enhanced-profile",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "web-search"
  ],
  "license": "MIT",
  "author": "Yurzi",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node ../../scripts/clean.ts && tsdown",
    "clean": "node ../../scripts/clean.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-deepseek-account": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-web-search-deepseek": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-deepseek-account": {
      "optional": true
    }
  },
  "devDependencies": {
    "dsh-tool-web-enhanced-core": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-deepseek-account": "catalog:",
    "@deepseek-ai/dsh-launch-environment": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-web": "catalog:",
    "@deepseek-ai/dsh-web-search-deepseek": "catalog:"
  }
}
