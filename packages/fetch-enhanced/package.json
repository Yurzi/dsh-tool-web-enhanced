{
  "name": "dsh-web-fetch-enhanced",
  "version": "0.2.0",
  "description": "web_fetch provider for DeepSeek Harness with switchable fetch connections: local fetching with optional private-network access, the DeepSeek Fetch API, or remote reading services (Exa, Firecrawl, Tavily, Tinyfish); installed through dsh-tool-web-enhanced-profile",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "web-fetch",
    "fake-ip",
    "allowlist"
  ],
  "license": "MIT",
  "author": "Yurzi",
  "homepage": "https://github.com/Yurzi/dsh-tool-web-enhanced/tree/main/packages/fetch-enhanced#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yurzi/dsh-tool-web-enhanced.git",
    "directory": "packages/fetch-enhanced"
  },
  "bugs": "https://github.com/Yurzi/dsh-tool-web-enhanced/issues",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.cjs",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.cjs",
    "lib/client.cjs.map",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
